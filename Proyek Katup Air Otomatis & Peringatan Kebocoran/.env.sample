# Ubah .env.sample menjadi .env dan isi dengan konfigurasi yang sesuai
# Wi-Fi Configuration
WIFI_SSID=Wokwi-GUEST  
WIFI_PASSWORD=

# Konfigurasi Ubidots MQTT
UBIDOTS_TOKEN=YOUR_UBIDOTS_TOKEN_HERE // Salin Default Token Anda dari Ubidots: Profile -> API Credentials -> Default Token
